-- =========================================================
-- 32. PROJECT WITH NUMBER OF TASKS
-- =========================================================

SELECT
    P.Project_Name,
    COUNT(T.Task_ID) AS Total_Tasks
FROM Project P
LEFT JOIN Task T
ON P.Project_ID = T.Project_ID
GROUP BY P.Project_ID, P.Project_Name;


