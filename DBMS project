-- =========================================================
-- 19. EMPLOYEE + DEPARTMENT
-- =========================================================

SELECT
    E.Employee_ID,
    E.Name,
    E.Role,
    D.Department_Name
FROM Employee E
JOIN Department D
ON E.Department_ID = D.Department_ID;


-- =========================================================
-- 20. PROJECT + CLIENT
-- =========================================================

SELECT
    P.Project_ID,
    P.Project_Name,
    C.Client_Name,
    P.Status
FROM Project P
JOIN Client C
ON P.Client_ID = C.Client_ID;


-- =========================================================
-- 21. TASK + EMPLOYEE
-- =========================================================

SELECT
    T.Task_ID,
    T.Task_Name,
    E.Name AS Employee_Name,
    T.Status,
    T.Deadline
FROM Task T
JOIN Employee E
ON T.Assigned_To = E.Employee_ID;


-- =========================================================
-- 22. PROJECT + TEAM
-- =========================================================

SELECT
    P.Project_Name,
    T.Team_Name
FROM Project P
JOIN Team T
ON P.Project_ID = T.Project_ID;


-- =========================================================
-- 23. PROJECT + MILESTONE
-- =========================================================

SELECT
    P.Project_Name,
    M.Milestone_Name,
    M.Due_Date,
    M.Status
FROM Project P
JOIN Milestone M
ON P.Project_ID = M.Project_ID;


